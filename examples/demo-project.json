{
  "name": "Demo API",
  "endpoints": [
    {
      "name": "List users",
      "method": "GET",
      "path": "/api/users",
      "request": {
        "query": [{ "name": "page", "required": false, "description": "Page number" }]
      },
      "response": {
        "status": 200,
        "body": {
          "type": "json",
          "content": {
            "data": [
              { "id": "b7e7f6c4-01e5-4d65-95d7-8f54f4f2c201", "name": "Alex Morgan", "email": "alex@example.test" },
              { "id": "3f1c2a9e-5b7d-4e8f-9a0b-1c2d3e4f5a6b", "name": "Sari Wulandari", "email": "sari@example.test" }
            ],
            "page": "{{ query.page }}"
          }
        }
      }
    },
    {
      "name": "Get user",
      "method": "GET",
      "path": "/api/users/:id",
      "response": {
        "status": 200,
        "body": { "type": "json", "content": { "data": { "id": "{{ path.id }}", "name": "Alex Morgan", "email": "alex@example.test" } } }
      },
      "rules": [
        {
          "name": "Unknown user",
          "when": [{ "source": { "from": "path", "name": "id" }, "operator": "equals", "value": "missing" }],
          "response": {
            "status": 404,
            "body": { "type": "json", "content": { "error": "User {{ path.id }} not found" } }
          }
        }
      ]
    },
    {
      "name": "Current user",
      "method": "GET",
      "path": "/api/users/me",
      "auth": { "type": "bearer" },
      "response": {
        "status": 200,
        "body": { "type": "json", "content": { "data": { "id": "me", "name": "Signed-in User" } } }
      }
    },
    {
      "name": "Create user",
      "method": "POST",
      "path": "/api/users",
      "request": {
        "body_schema": {
          "type": "object",
          "required": ["name", "email"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "email": { "type": "string" },
            "age": { "type": "integer", "minimum": 0 }
          }
        },
        "body_example": { "name": "Alex Morgan", "email": "alex@example.test" }
      },
      "response": {
        "status": 201,
        "headers": { "Location": "/api/users/{{ request.id }}" },
        "body": {
          "type": "json",
          "content": { "data": { "id": "{{ request.id }}", "name": "{{ body.name }}", "email": "{{ body.email }}", "created_at": "{{ now }}" } }
        }
      }
    },
    {
      "name": "Delete user",
      "method": "DELETE",
      "path": "/api/users/:id",
      "response": { "status": 204 }
    },
    {
      "name": "Slow report",
      "method": "GET",
      "path": "/api/reports/slow",
      "response": {
        "status": 200,
        "delay_ms": 1500,
        "body": { "type": "text", "content": "Report ready at {{ now }}" }
      }
    },
    {
      "name": "Legacy endpoint (disabled)",
      "method": "GET",
      "path": "/api/legacy",
      "enabled": false,
      "response": { "status": 200 }
    }
  ],
  "resources": [
    {
      "name": "products",
      "path": "/api/products",
      "key_strategy": "increment",
      "schema": {
        "fields": [
          { "name": "sku", "type": "template", "template": "SKU-????-####", "unique": true },
          { "name": "name", "type": "words", "min": 2, "max": 3 },
          { "name": "price", "type": "decimal", "min": 5, "max": 500, "scale": 2 },
          { "name": "in_stock", "type": "boolean" },
          { "name": "supplier", "type": "company" },
          { "name": "added", "type": "date", "from": "2025-01-01", "to": "2026-06-30" }
        ]
      },
      "seed": { "count": 50, "seed": 2026 },
      "body_schema": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "minimum": 0 }
        }
      },
      "searchable": ["name", "sku", "supplier"],
      "pagination": { "default_limit": 10, "max_limit": 50 }
    },
    {
      "name": "reviews",
      "path": "/api/reviews",
      "schema": {
        "fields": [
          { "name": "product_id", "type": "reference", "resource": "products" },
          { "name": "author", "type": "full_name" },
          { "name": "rating", "type": "integer", "min": 1, "max": 5 },
          { "name": "comment", "type": "words", "min": 3, "max": 8, "null_rate": 0.2 }
        ]
      },
      "seed": { "count": 120, "seed": 7, "locale": "id" },
      "delete": "soft"
    }
  ]
}
