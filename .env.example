# Copy to .env for `docker compose`. Never commit .env.

# Required. Clients send it as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
WORKBENCH_API_TOKEN=

# Required. Password for the bundled PostgreSQL.
POSTGRES_PASSWORD=

# Optional. 64 hex characters (openssl rand -hex 32) that encrypt
# environment secrets. Without it, a key file is created in the data volume.
WORKBENCH_SECRET_KEY=

# Optional. Host port for the UI and API (default 8080).
WORKBENCH_PORT=8080
